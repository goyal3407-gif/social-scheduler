# Social Scheduler — environment variables.
# Set these in Vercel (Project Settings > Environment Variables, ALL
# environments), never in the repo and never paste real values here.
# The app does NOT work durably on Vercel without MONGODB_URI and
# SESSION_SECRET: without them accounts/posts live in temporary files and
# logins die on every redeploy.

# REQUIRED — MongoDB Atlas connection string for the scheduler's OWN
# database ("social_scheduler", a separate database in the same Atlas
# cluster as PureNest). The code forces dbName=social_scheduler, so the
# database name in this string does not matter. Keep it in Vercel only.
MONGODB_URI=

# REQUIRED — long random string that signs login cookies. Without it every
# user is logged out on each restart/redeploy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OPTIONAL — key that encrypts the stored Instagram token. Defaults to
# SESSION_SECRET when not set. Only needed if you want a separate key.
TOKEN_ENCRYPTION_KEY=

# OPTIONAL but recommended — enables the auto-publish cron endpoint
# (POST /api/cron/publish-due). The endpoint only runs when called with
# header "Authorization: Bearer <CRON_SECRET>". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# OPTIONAL — Instagram Graph API fallback (a token pasted in Settings,
# verified live, takes priority). Publishing works only for the Instagram
# account the token belongs to (dev-mode app: your own account only).
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=

# OPTIONAL — Meta app credentials for automatic token renewal. The app
# renews Instagram Login tokens by itself (no secret needed). For
# Facebook Login tokens, the renewal exchange requires the app secret:
# set META_APP_SECRET once (Meta app dashboard > Settings > Basic) and
# renewal becomes fully automatic for those tokens too. META_APP_ID
# defaults to this app's public ID when not set.
META_APP_ID=
META_APP_SECRET=

# OPTIONAL — "Connect Instagram" Meta login (OAuth). META_LOGIN_CONFIG_ID
# is the Facebook Login for Business configuration ID from the Meta app
# dashboard (Use cases > Instagram API > Customize); it defaults to this
# app's public config ID when not set. META_OAUTH_REDIRECT_URI must match
# the OAuth redirect URI configured in the Meta app EXACTLY; it defaults
# to https://social-scheduler-one-sandy.vercel.app/api/instagram/callback.
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=

# OPTIONAL — "Connect Instagram" direct Instagram Login (Meta's
# "Instagram API with Instagram Login"). INSTAGRAM_APP_ID and
# INSTAGRAM_APP_SECRET are the INSTAGRAM app's own credentials (Meta
# dashboard > the app > Instagram API > API setup with Instagram
# login) — NOT the Facebook app's credentials above. Until both are
# set, the direct flow shows a friendly "not configured yet" page and
# the Facebook flow remains the working route. The redirect URI
# https://social-scheduler-one-sandy.vercel.app/api/instagram/ig-callback
# must be added to the Instagram app's Valid OAuth Redirect URIs
# exactly; IG_LOGIN_REDIRECT_URI overrides it only if it ever moves.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
IG_LOGIN_REDIRECT_URI=
