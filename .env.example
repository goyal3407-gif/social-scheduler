# Social Scheduler — environment variables.
# Set these in Vercel (Project Settings > Environment Variables, ALL
# environments), never in the repo and never paste real values here.
# The app does NOT work durably on Vercel without MONGODB_URI and
# SESSION_SECRET: without them accounts/posts live in temporary files and
# logins die on every redeploy.

# REQUIRED — MongoDB Atlas connection string for the scheduler's OWN
# database ("social_scheduler", a separate database in the same Atlas
# cluster as PureNest). The code forces dbName=social_scheduler, so the
# database name in this string does not matter. Keep it in Vercel only.
MONGODB_URI=

# REQUIRED — long random string that signs login cookies. Without it every
# user is logged out on each restart/redeploy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OPTIONAL — key that encrypts the stored Instagram token. Defaults to
# SESSION_SECRET when not set. Only needed if you want a separate key.
TOKEN_ENCRYPTION_KEY=

# OPTIONAL but recommended — enables the auto-publish cron endpoint
# (POST /api/cron/publish-due). The endpoint only runs when called with
# header "Authorization: Bearer <CRON_SECRET>". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# OPTIONAL — Instagram Graph API fallback (a token pasted in Settings,
# verified live, takes priority). Publishing works only for the Instagram
# account the token belongs to (dev-mode app: your own account only).
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=

# OPTIONAL — Meta app credentials for automatic token renewal. The app
# renews Instagram Login tokens by itself (no secret needed). For
# Facebook Login tokens, the renewal exchange requires the app secret:
# set META_APP_SECRET once (Meta app dashboard > Settings > Basic) and
# renewal becomes fully automatic for those tokens too. META_APP_ID
# defaults to this app's public ID when not set.
META_APP_ID=
META_APP_SECRET=

# OPTIONAL — "Connect Instagram" Meta login (OAuth). META_LOGIN_CONFIG_ID
# is the Facebook Login for Business configuration ID from the Meta app
# dashboard (Use cases > Instagram API > Customize); it defaults to this
# app's public config ID when not set. The SAME configuration powers
# both connect flows: the Facebook flow (callback
# /api/instagram/callback, META_OAUTH_REDIRECT_URI) and the primary
# Unified Login flow (callback /api/instagram/ig-callback,
# IG_LOGIN_REDIRECT_URI). Both redirect URIs must be registered for
# the configuration in the Meta app dashboard EXACTLY; both default to
# this app's production URLs when not set. Unified Login also needs
# META_APP_ID + META_APP_SECRET above (the Meta app's own credentials —
# there is no separate Instagram app ID/secret for newer apps).
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=
IG_LOGIN_REDIRECT_URI=

# LEGACY — INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET belonged to the
# retired "Instagram API with Instagram Login" setup, which Meta no
# longer offers to newer apps (this app has no Instagram platform app;
# its dialog answered "Invalid platform app"). No connect flow reads
# them. They are only still consulted when debugging a stored
# Instagram-Login token (tokenHost "instagram") from that era, and can
# be left unset.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# OPTIONAL — AI caption assistant (batch 3). A free Google AI Studio
# API key for Gemini; the Studio's "Suggest a caption" calls it
# server-side with a per-user daily cap from the plan config. Without
# it the assistant answers "not switched on yet" and everything else
# works exactly as before — AI never blocks scheduling.
# GEMINI_MODEL / GEMINI_API_BASE exist for tests and model changes;
# leave them unset in production.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE=

# OPTIONAL — password-reset email sender (SMTP). The ONLY email the
# app sends is the "Forgot password?" reset link. Without these, the
# reset flow still runs (token + /reset page) but no email leaves the
# server; in non-production the link is written to the server log only.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the
# KiluaAI Gmail address>, SMTP_PASS=<a Gmail App Password for that
# account — create one at myaccount.google.com/apppasswords; never a
# normal account password, and never another project's App Password>,
# MAIL_FROM=<the same Gmail address>.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# OPTIONAL — YouTube cross-post (Phase B). Google Cloud project with
# the YouTube Data API v3 enabled + an OAuth web client whose
# authorized redirect URI is exactly the callback below; the consent
# screen needs scopes youtube.upload + youtube.readonly. Without both
# variables the YouTube feature stays off and the app behaves exactly
# as before.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=https://social-scheduler-one-sandy.vercel.app/api/youtube/callback

# OPTIONAL — OCI Object Storage media backend. When BOTH are set, new
# uploads are stored as objects in the OCI bridge bucket (via
# pre-authenticated request base URLs, each ending in "/o/") instead of
# as binaries in the database mediafiles store; the read base is the
# public URL Instagram fetches, the write base also serves deletes.
# Leave both unset for the default database storage.
MEDIA_OCI_READ_BASE=
MEDIA_OCI_WRITE_BASE=

# OPTIONAL (only with the OCI backend above) — signed object deletes.
# A write PAR cannot delete objects (OCI permits PUT only through a
# PAR), so real post-publish/library deletes need a signed DeleteObject
# call: the OCI API private key (PEM; use \n for newlines), the tenancy
# and user OCIDs, the key fingerprint, and the storage namespace +
# bucket name. MEDIA_OCI_REGION defaults to ap-mumbai-1. Without these,
# deletes are best-effort and removed copies linger in the bucket.
# MEDIA_OCI_API_KEY_PEM may instead be supplied base64-encoded as a
# single line (the whole PEM file, base64) — it is auto-detected and
# decoded. Prefer that form when entering the key through a web
# dashboard: multi-line pastes can arrive invisibly corrupted.
MEDIA_OCI_API_KEY_PEM=
MEDIA_OCI_TENANCY_OCID=
MEDIA_OCI_USER_OCID=
MEDIA_OCI_FINGERPRINT=
MEDIA_OCI_REGION=
MEDIA_OCI_NAMESPACE=
MEDIA_OCI_BUCKET=
