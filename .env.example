# Social Scheduler — environment variables.
# Set these in Vercel (Project Settings > Environment Variables, ALL
# environments), never in the repo and never paste real values here.
# The app does NOT work durably on Vercel without MONGODB_URI and
# SESSION_SECRET: without them accounts/posts live in temporary files and
# logins die on every redeploy.

# REQUIRED — MongoDB Atlas connection string for the scheduler's OWN
# database ("social_scheduler", a separate database in the same Atlas
# cluster as PureNest). The code forces dbName=social_scheduler, so the
# database name in this string does not matter. Keep it in Vercel only.
MONGODB_URI=

# REQUIRED — long random string that signs login cookies. Without it every
# user is logged out on each restart/redeploy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OPTIONAL — key that encrypts the stored Instagram token. Defaults to
# SESSION_SECRET when not set. Only needed if you want a separate key.
TOKEN_ENCRYPTION_KEY=

# OPTIONAL — Instagram Graph API fallback (a token pasted in Settings,
# verified live, takes priority). Publishing works only for the Instagram
# account the token belongs to (dev-mode app: your own account only).
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
